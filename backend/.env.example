# Flask Server Configuration
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=replace_with_a_secure_secret_key

# Academic Admin Role Passcode (Sent via X-Admin-Passcode header for admin routes)
ADMIN_PASSCODE=admin123

# CORS Configuration (Vite dev server origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL 8 Database Connection (Replace placeholders in your local .env file)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mysql123
DB_NAME=hotel_reservation_db
TEST_DB_NAME=hotel_reservation_test_db
